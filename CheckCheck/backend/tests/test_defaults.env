# Default config for the backend test server. Tracked on purpose: every value
# here is a throwaway test value, never a real secret, so a fresh clone (and CI)
# can run the suite without any setup.
#
# conftest.py loads it into the environment of the test process (and therefore
# of the server subprocess) with this precedence, highest first:
#   1. real environment variables (e.g. `LOG_LEVEL=DEBUG ./run_backend_tests_with_sqlite.sh`)
#   2. tests/.env, optional and gitignored: your personal overrides
#   3. this file
# Settings conftest.py forces itself (admin user, DB URL, mail, provisioning)
# are not configurable here.
LOG_LEVEL=INFO
DEBUG_SQL=False
AUTH_JWT_SECRET=test-only-jwt-secret-000000000000000000000000000000000000000000000
SERVER_SESSION_SECRET=test-only-session-secret-0000000000000000000000000000000000000000
SERVER_BIND_PORT=8888
SERVER_PUBLIC_URL=http://localhost:8888
AUTH_BASIC_LOGIN_IS_ENABLED=true
AUTH_BASIC_USER_DB_REGISTER_ENABLED=false
AUTH_ACCESS_TOKEN_EXPIRES_MINUTES=1000
AUTH_OIDC_TOKEN_STORAGE_SECRET=test-only-oidc-storage-secret-checkcheck
# SQLite only: delete tests/testdb.sqlite before the run. Set to False (e.g. in
# tests/.env) to keep the DB across runs for inspection.
CHECKCHECK_TESTS_RESET_DB=True
